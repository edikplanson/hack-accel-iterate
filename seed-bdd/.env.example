# Copier ce fichier en .env et remplir les valeurs (ne jamais commiter le .env)

# Console Aiven > service PostgreSQL > Overview > Service URI
DATABASE_URL=postgres://avnadmin:MOT_DE_PASSE@pg-xxxxxxx-jambon-fromage.aivencloud.com:12345/defaultdb?sslmode=require

# kaggle.com > Settings > API > Create New Token : valeurs "username" et "key" du kaggle.json
KAGGLE_USERNAME=ton_username_kaggle
KAGGLE_KEY=ta_cle_kaggle

# Nombre de mois de transactions à garder (le dataset complet fait environ 13 millions de lignes)
TX_MONTHS=24
