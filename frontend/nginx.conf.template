server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Résolution DNS de l'agent à la requête (et non au démarrage) : si l'agent n'est pas encore
    # joignable, nginx démarre quand même au lieu de planter en "host not found in upstream"
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $agent_url ${AGENT_URL};

    # Appels API relayés vers le conteneur agent (même origine, pas de CORS)
    location /api/ {
        proxy_pass $agent_url;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
        # Flux SSE (/api/chat/stream) : pas de mise en tampon, chaque événement part tout de suite
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";
    }

    location = /health/agent {
        proxy_pass $agent_url/health;
        proxy_ssl_server_name on;
    }

    location = /health {
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        try_files $uri /index.html;
    }
}
