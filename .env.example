# Copier en .env à la racine du repo et remplir (ne jamais commiter le .env)

# Aiven PostgreSQL : console Aiven > service > Overview > Service URI
DATABASE_URL=postgres://avnadmin:MOT_DE_PASSE@HOTE.aivencloud.com:PORT/defaultdb?sslmode=require

# Aiven OpenSearch (règles internes de la banque, PDF indexés) : console Aiven > service > Overview > Service URI
OPENSEARCH_URL=
OPENSEARCH_INDEX=rules-current

# LLM de l'agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

BANK_NAME=Banque Horizon

# Laisser vide en local. Sur Aiven Runtime, mettre l'URL publique de l'app agent
# si le front n'arrive pas à joindre http://agent:8000
AGENT_URL=

# Seed de la base (dossier seed-bdd)
KAGGLE_USERNAME=
KAGGLE_KEY=
TX_MONTHS=24
