# Merge into ignored root .env or platform secrets. Do not replace existing credentials.
# Existing main variables remain compatible.
DATABASE_URL=
DATABASE_SSLROOTCERT=
DATABASE_CA_CERT=
ALLOW_INSECURE_LOCAL=false
BANK_NAME=Banque Horizon
PORT=8000

# Adding a key alone never enables inference. Keep false until API use is authorized.
MODEL_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MODEL_BUDGET_USD=5
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_CONCURRENCY=2
MODEL_INPUT_USD_PER_MILLION=2
MODEL_OUTPUT_USD_PER_MILLION=10

# OpenSearch URL has no embedded credentials. TLS is always verified remotely.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERT=
OPENSEARCH_CA_PEM=
OPENSEARCH_INDEX=banking-procedures

# New session/transcript integration routes have separate authorization.
ADVISOR_API_TOKEN=
TRANSCRIPT_TOKEN=
